{
  "name": "deepseek-webclip",
  "version": "1.0.0",
  "private": true,
  "description": "通过 API 接收网址，用无头浏览器抓取网页，过滤广告等无关内容，转为 Markdown，并把多媒体文件保存到本地图床",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node test/smoke.test.mjs && node test/ui.test.mjs",
    "test:api": "node test/smoke.test.mjs",
    "test:ui": "node test/ui.test.mjs",
    "test:runner": "node --test test/",
    "doctor:xhs": "node src/cli/xhs-doctor.js",
    "smoke": "node test/smoke.test.mjs",
    "docker:build": "docker build -t webclip:latest .",
    "docker:up": "docker compose up -d --build"
  },
  "dependencies": {
    "@mozilla/readability": "0.5.0",
    "dotenv": "16.4.7",
    "express": "4.21.2",
    "jsdom": "25.0.1",
    "playwright": "1.49.1",
    "turndown": "7.2.0",
    "turndown-plugin-gfm": "1.0.2"
  }
}
