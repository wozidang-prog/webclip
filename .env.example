# ---- 服务 ----
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
LOG_LEVEL=info

# Markdown 里图片链接的前缀。部署到服务器时务必改成外部可访问的地址！
# 例如：https://clip.example.com
PUBLIC_BASE_URL=http://localhost:3000

# 留空 = 接口不鉴权。设置后 /api/* 需要 x-api-token: <token> 或 Authorization: Bearer <token>
API_TOKEN=

# 数据目录（图床文件 + Markdown 文章）
DATA_DIR=./data

# ---- 运行用户 / 权限（NAS 部署必看）----
# 容器以 root 启动，按 PUID:PGID 修好 DATA_DIR 属主后降权运行。
# 出现 "EACCES: permission denied, mkdir '/data/media'" 时：
#   ls -nd /volume1/docker/webclip/data     # 看宿主机目录属主
#   PUID=1026 PGID=100                      # 群晖常见（威联通多为 1000:1000）
PUID=1000
PGID=1000
# ACL/NFS 导致 chown 失败时的兜底：以 root 运行
RUN_AS_ROOT=false
# 设为 false 则完全不修改你的目录属主（需自行保证可写）
CHOWN_ON_START=true

# ---- 网址记录 / 正文副本（SQLite，用 Node 内置 node:sqlite）----
DATABASE_ENABLED=true
DATABASE_FILE=
# 重新抓取同一网址时，正文指纹一致就复用已有文章、不再下载媒体（force=true 可强制重抓）
SKIP_UNCHANGED_REFRESH=true

# ---- Markdown 输出 ----
# 视频/音频在 Markdown 里的表示：html（默认，<video controls> 阅读模式可直接播）/ link / both
VIDEO_MARKDOWN=html

# ---- 下载文件自动命名 ----
# 占位符：{date} 发布日(缺省用抓取日) {clipdate} 抓取日 {time} 抓取时间
#         {datetime} 抓取日期时间 {title} 标题 {site} 站点名 {host} 域名
#         {author} 作者 {id} 文章 id {words} 字数 {lang} 语言
# 默认带日期，便于归档且不会重名；想只用标题就写 {title}
FILENAME_TEMPLATE={date}-{title}
# 文件名长度上限：字符数 + 字节数（ext4/NTFS 单个文件名最多 255 字节，中文 3 字节/字）
FILENAME_MAX_LENGTH=100
FILENAME_MAX_BYTES=200

# ---- 抓取 ----
# 抖音 / 小红书这类"媒体地址只在页面 JS 数据里"的站点，会自动解析页面数据补出图片与视频，
# 无需额外开关（接口参数 recoverEmbeddedMedia=false 可关掉整类兜底行为）。
USER_AGENT=
NAVIGATION_TIMEOUT_MS=45000
PAGE_SETTLE_MS=800
PAGE_AUTO_SCROLL=true
PAGE_SCROLL_STEPS=12
CONVERT_CONCURRENCY=3
CONVERT_JOB_TIMEOUT_MS=120000
CONVERT_MAX_BATCH=10
RATE_LIMIT_PER_MINUTE=0

# ---- 浏览器 ----
# 有头模式：设 false 时容器入口脚本会自动拉起 Xvfb（镜像已装），浏览器以"有头"运行。
# 抖音这类站点的风控盯着无头浏览器时，有头 + 虚拟显示通常能过。
BROWSER_HEADLESS=true
# 只要 Xvfb、不改 headless 配置时用这个；XVFB_SCREEN 可调分辨率
XVFB_ENABLED=false
XVFB_DISPLAY=:99
XVFB_SCREEN=1920x1080x24
CHROMIUM_NO_SANDBOX=false
# 指定浏览器：BROWSER_CHANNEL=chrome / msedge，或 BROWSER_EXECUTABLE_PATH=/usr/bin/chromium
# 留空时会依次尝试：Playwright 自带 Chromium → 本机 Chrome → 本机 Edge（自动兜底）
BROWSER_CHANNEL=
BROWSER_EXECUTABLE_PATH=
# 浏览器上下文的 UA：留空（默认）= 用浏览器自己的真实 UA，推荐保持留空。
# 千万别设成与真实浏览器不符的值（例如在 Linux 容器里设 Windows UA）——
# 实测抖音会因"UA 与浏览器身份矛盾"直接返回空数据，什么都抓不到。
BROWSER_USER_AGENT=
BROWSER_IDLE_CLOSE_MS=300000
# 触发页面播放器（MSE）后等待多久再收网：抖音的视频流只有开始播放才会发请求
PAGE_PLAY_NUDGE_MS=4000

# ---- ffmpeg（可选但推荐）----
# 抖音 /video/<id> 这类页面把音视频拆成两条 DASH 流，需要 ffmpeg 合回一个带声音的 MP4。
# 留空时自动找：PATH 上的 ffmpeg → Playwright 自带的 ffmpeg；都找不到就分别保存
# （视频没声音、音频单独存成 .m4a），并在报告里给出提示。
FFMPEG_PATH=

# ---- 站点 Cookie（需要登录的站点）----
# 抖音 / 小红书：把浏览器里登录后的 Cookie 整段贴进来即可，抓对应站点时自动带上；
# 单次请求里的 cookies 参数优先级更高。抖音、小红书不登录基本看不了，建议都配上。
DOUYIN_COOKIE=
XIAOHONGSHU_COOKIE=
# 小红书自建解析 API（如 https://github.com/JoeanAmier/XHS-Downloader）
# 填入后，小红书链接优先调用此 API 解析（一次拿到标题/正文/图片视频直链），无需 Cookie 也能抓取；
# 解析不出来会自动回退到页面解析。短链 xhslink.cn/xhslink.com 会先被自动展开成规范笔记地址。
# 示例：http://xhs-parser.example.com:5556/xhs/detail
XIAOHONGSHU_API=
XIAOHONGSHU_API_TIMEOUT_MS=30000
# 配了解析器时，小红书是否「只用解析器、完全不抓网页」（默认 true，强烈建议保持）。
# 网页端未登录/被风控只会返回「安全限制」这类页面：抓它拿不到内容，还容易把验证引到抓取机上。
# 设 false 则恢复"先抓网页、解析器只当兜底"的老行为。
XIAOHONGSHU_PARSER_ONLY=true
# 其它站点：JSON，键是域名（子域自动匹配），值是 Cookie 字符串
# SITE_COOKIES={"zhihu.com":"z_c0=xxx","bilibili.com":"SESSDATA=xxx"}
SITE_COOKIES=

# ---- 只下载视频图片模式（API: mediaOnly=1）----
# 该模式把媒体存到下面这个独立目录（默认与 DATA_DIR 同级的大文件夹），默认不落文章。
# 目录结构与主图床一致：<站点域名>/<标题>/01.jpg…
MEDIA_ONLY_DIR=
# Docker 里要同时把 /media-only 挂出来（compose 已带 webclip-media-only 卷），否则文件随容器消失

# ---- webhook 通知（抓完发消息）----
# 留空 = 不发。配了之后：mediaOnly=1 的请求会自动发一条；普通请求可显式传 webhook=true 打开。
# 群晖 Chat（DSM 的 Chat 套件）：在 Chat 里「频道 → 集成 → 传入 Webhook」生成地址，形如
#   https://<NAS>:5001/webapi/chatbot/send?token=xxxxxxxx
# 把整条地址填到下面，格式选 synology 即可。注意：群晖 Chat 的传入 Webhook 只能发文本，
# 消息里带的是每个视频/图片的下载直链（手机上点一下就能看/存）。
WEBHOOK_URL=
# 报文格式：json（默认，完整 JSON）/ text / slack / synology（群晖 Chat）/ feishu / dingtalk / wecom
WEBHOOK_FORMAT=json
# 附加请求头（JSON），例如自建端点需要鉴权：{"Authorization":"Bearer xxx"}
WEBHOOK_HEADERS=
WEBHOOK_TIMEOUT_MS=10000
# 群晖/NAS 常用自签名证书，这时 fetch 会报 UNABLE_TO_VERIFY_LEAF_SIGNATURE，设 false 才发得出去
# （只影响 webhook 这一个请求，不影响抓取）
WEBHOOK_TLS_VERIFY=true
# 消息超过平台单条上限时自动分条发送（群晖实测上限约 2000 字，程序按 1900 切）：
#   每条之间的间隔毫秒数，避免群晖的 "create post too fast" 限流
WEBHOOK_PART_DELAY_MS=1500
# 手动覆盖单条字数上限（0 = 用各平台默认值）
WEBHOOK_MAX_CHARS=0

# ---- 图床容量 ----
# 媒体目录布局（都会先按网站分一层目录，见下面的 MEDIA_GROUP_BY_SITE）：
#   folder（默认）data/media/<站点域名>/<文章标题>/01.jpg、02.png、03.mp4 …
#                 同一篇文章的图片/视频放在一个以标题命名的文件夹里，按正文出现顺序编号
#   flat          data/media/<站点域名>/<内容哈希>.jpg（内容寻址：同一份内容跨文章只存一份，最省磁盘，
#                 重复抓取时可零下载命中缓存；代价是文件名不可读）
# 也可以在单次请求里用 mediaLayout 覆盖（/api/convert 支持 mediaLayout 或 layout 字段）
MEDIA_LAYOUT=folder
# 媒体再按网站分一层目录（默认开）：data/media/douyin.com/…、data/media/xiaohongshu.com/…
# 关掉则退回旧的扁平结构（media/<标题>/… 或 media/<哈希>.ext）。
# 老文章不受影响：每条图床记录都存着自己的相对路径，改写后仍按原路径读取与访问。
MEDIA_GROUP_BY_SITE=true
# 单张图片上限（字节）
MAX_MEDIA_FILE_BYTES=26214400
# 单个视频上限（视频动辄几十上百 MB，默认 256MiB）
MAX_VIDEO_BYTES=268435456
# 单个音频上限
MAX_AUDIO_BYTES=67108864
# 单页图片+音频总量上限
MAX_MEDIA_BYTES_PER_PAGE=83886080
# 单页视频总量上限
MAX_VIDEO_BYTES_PER_PAGE=536870912
# 单页媒体数量上限
MAX_MEDIA_FILES_PER_PAGE=80
# 图床总容量（超出按最久未使用淘汰）
MAX_MEDIA_TOTAL_BYTES=5368709120
MEDIA_PRUNE_ON_WRITE=true

# ---- 安全 ----
# 允许抓取内网/回环地址（默认 false，防 SSRF；自建内网服务时才开）
ALLOW_PRIVATE_NETWORK=false
ALLOW_FILE_PROTOCOL=false

# ---- 过滤 ----
ADBLOCK_DISABLE=0
# 追加广告域名（逗号分隔的域名后缀）
ADBLOCK_EXTRA_DOMAINS=

# ---- 抓取类型过滤（可选，逗号分隔） ----
# FETCH_TIMEOUT_MS=20000
# FETCH_MAX_REDIRECTS=5
